---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{
  slug === 'interes-compuesto' && (
    <form class="calc-layout" data-calc="compound">
      <div>
        <label class="field">
          <span>Dinero al empezar</span>
          <input name="principal" type="number" min="0" step="0.01" value="1000" inputmode="decimal" />
        </label>
        <label class="field">
          <span>Años</span>
          <input name="years" type="number" min="0" max="80" step="1" value="10" />
        </label>
        <label class="field">
          <span>Interés al año, % (un supuesto)</span>
          <input name="rate" type="number" min="0" max="30" step="0.1" value="5" />
        </label>
        <label class="field">
          <span>Cada cuánto se suma</span>
          <select name="frequency">
            <option value="12" selected>Cada mes</option>
            <option value="4">Cada trimestre</option>
            <option value="1">Cada año</option>
          </select>
        </label>
        <label class="field">
          <span>Aportación en cada uno de esos periodos</span>
          <input name="contribution" type="number" min="0" step="0.01" value="50" />
        </label>
      </div>
      <div>
        <p class="result-error" data-error role="alert"></p>
        <div class="results" data-results aria-live="polite"></div>
      </div>
    </form>
  )
}

{
  slug === 'meta-ahorro' && (
    <form class="calc-layout" data-calc="goal">
      <div>
        <label class="field">
          <span>Meta</span>
          <input name="target" type="number" min="0" step="0.01" value="10000" />
        </label>
        <label class="field">
          <span>Dinero al empezar</span>
          <input name="principal" type="number" min="0" step="0.01" value="1000" />
        </label>
        <label class="field">
          <span>Años</span>
          <input name="years" type="number" min="1" max="80" step="1" value="5" />
        </label>
        <label class="field">
          <span>Interés al año, % (un supuesto)</span>
          <input name="rate" type="number" min="0" max="30" step="0.1" value="3" />
        </label>
        <label class="field">
          <span>Cada cuánto apartas</span>
          <select name="frequency">
            <option value="12" selected>Cada mes</option>
            <option value="4">Cada trimestre</option>
            <option value="1">Cada año</option>
          </select>
        </label>
      </div>
      <div>
        <p class="result-error" data-error role="alert"></p>
        <div class="results" data-results aria-live="polite"></div>
      </div>
    </form>
  )
}

{
  slug === 'fondo-emergencia' && (
    <form class="calc-layout" data-calc="emergency">
      <div>
        <label class="field">
          <span>Gastos imprescindibles al mes</span>
          <input name="essentials" type="number" min="0" step="0.01" value="1200" />
          <small>Casa, comida, luz, transporte necesario. Sin caprichos.</small>
        </label>
        <label class="field">
          <span>Meses de colchón</span>
          <input name="months" type="number" min="1" max="36" step="1" value="6" />
        </label>
        <label class="field">
          <span>Ya guardado</span>
          <input name="saved" type="number" min="0" step="0.01" value="1000" />
        </label>
        <label class="field">
          <span>Lo que puedes apartar al mes</span>
          <input name="monthly" type="number" min="0" step="0.01" value="200" />
        </label>
      </div>
      <div>
        <p class="result-error" data-error role="alert"></p>
        <div class="results" data-results aria-live="polite"></div>
      </div>
    </form>
  )
}

{
  slug === 'presupuesto-50-30-20' && (
    <form class="calc-layout" data-calc="budget">
      <div>
        <label class="field">
          <span>Ingreso del mes</span>
          <input name="income" type="number" min="0" step="0.01" value="2000" />
        </label>
        <p class="fine">Opcional: lo que ya haces. Si lo dejas vacío, solo verás la regla.</p>
        <label class="field">
          <span>Ahora, necesidades</span>
          <input name="needs" type="number" min="0" step="0.01" value="" />
        </label>
        <label class="field">
          <span>Ahora, deseos</span>
          <input name="wants" type="number" min="0" step="0.01" value="" />
        </label>
        <label class="field">
          <span>Ahora, ahorro</span>
          <input name="savings" type="number" min="0" step="0.01" value="" />
        </label>
      </div>
      <div>
        <p class="result-error" data-error role="alert"></p>
        <div class="results" data-results aria-live="polite"></div>
      </div>
    </form>
  )
}

{
  slug === 'inflacion' && (
    <form class="calc-layout" data-calc="inflation">
      <div>
        <label class="field">
          <span>Precio de hoy</span>
          <input name="price" type="number" min="0" step="0.01" value="100" />
        </label>
        <label class="field">
          <span>Dinero quieto</span>
          <input name="cash" type="number" min="0" step="0.01" value="100" />
          <small>Lo que no se mueve. Si lo dejas igual que el precio, comparas las dos lecturas.</small>
        </label>
        <label class="field">
          <span>Inflación al año, % (un supuesto)</span>
          <input name="rate" type="number" min="0" max="30" step="0.1" value="3" />
        </label>
        <label class="field">
          <span>Años</span>
          <input name="years" type="number" min="0" max="80" step="1" value="10" />
        </label>
      </div>
      <div>
        <p class="result-error" data-error role="alert"></p>
        <div class="results" data-results aria-live="polite"></div>
      </div>
    </form>
  )
}

{
  slug === 'deudas' && (
    <form class="calc-layout" data-calc="debt">
      <div>
        <label class="field">
          <span>Lo que debes</span>
          <input name="balance" type="number" min="0" step="0.01" value="3000" />
        </label>
        <label class="field">
          <span>Interés al año, %</span>
          <input name="rate" type="number" min="0" max="40" step="0.1" value="18" />
        </label>
        <label class="field">
          <span>Pago al mes</span>
          <input name="payment" type="number" min="0" step="0.01" value="100" />
        </label>
        <label class="field">
          <span>Extra al mes</span>
          <input name="extra" type="number" min="0" step="0.01" value="25" />
        </label>
        <label class="field">
          <span>Si quisieras acabar en tantos meses (opcional)</span>
          <input name="horizon" type="number" min="1" max="600" step="1" value="" />
        </label>
      </div>
      <div>
        <p class="result-error" data-error role="alert"></p>
        <div class="results" data-results aria-live="polite"></div>
      </div>
    </form>
  )
}

{
  slug === 'independencia-financiera' && (
    <form class="calc-layout" data-calc="fire">
      <div>
        <label class="field">
          <span>Gasto al año</span>
          <input name="expenses" type="number" min="0" step="0.01" value="24000" />
        </label>
        <label class="field">
          <span>Retirada al año, %</span>
          <input name="withdrawal" type="number" min="0.5" max="10" step="0.1" value="4" />
          <small>4 es la regla de pulgar. No es una promesa.</small>
        </label>
        <label class="field">
          <span>Capital hoy</span>
          <input name="current" type="number" min="0" step="0.01" value="20000" />
        </label>
        <label class="field">
          <span>Ahorro al año</span>
          <input name="savings" type="number" min="0" step="0.01" value="6000" />
        </label>
        <label class="field">
          <span>Tipo anual supuesto, %</span>
          <input name="rate" type="number" min="0" max="20" step="0.1" value="5" />
        </label>
      </div>
      <div>
        <p class="result-error" data-error role="alert"></p>
        <div class="results" data-results aria-live="polite"></div>
      </div>
    </form>
  )
}

<p class="fine">El cálculo se hace en este aparato. No se envía a ningún servidor.</p>

<script>
  import '../../scripts/calculators.ts';
</script>
