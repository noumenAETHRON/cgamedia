---
import { getCollection, render } from 'astro:content';
import AudienceText from '../../components/AudienceText.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('workflows');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.description} ogType="article">
  <article class="wrap">
    <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Workflows', href: '/workflows/' }, { name: item.data.title }]} />
    <header class="page-intro">
      <p class="kicker">Workflow</p>
      <h1>{item.data.title}</h1>
      <p class="lead"><AudienceText texts={item.data.summary} block /></p>
      <p class="only-ninos banner">Esto está escrito para mayores. Si quieres, vuelve a los juegos.</p>
      <p class="only-abuelos banner">Puedes leerlo con calma. En este modo la letra es más grande.</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <RelatedTools slugs={item.data.tools} />
    <Disclaimer />
  </article>
</BaseLayout>
