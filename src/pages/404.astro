---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="Esa dirección no está en CGA Media." noindex>
  <div class="wrap page-intro">
    <p class="kicker">404</p>
    <h1>Esta dirección no está en el mapa</h1>
    <p class="lead">Puede que el episodio aún no exista, o que el enlace se haya quedado viejo.</p>
    <div class="button-row">
      <a class="button button-gold" href="/">Volver al inicio</a>
      <a class="button" href="/episodios/">Episodios</a>
      <a class="button" href="/laboratorio/">Laboratorio</a>
    </div>
  </div>
</BaseLayout>
